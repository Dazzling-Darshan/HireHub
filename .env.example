# Server Configuration
PORT=8000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Option A: Cloud MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portal
# Option B: Docker Compose Local MongoDB
# MONGO_URI=mongodb://mongodb:27017/portal

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary (File/Image Uploads)
CLOUD_NAME=your_cloudinary_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Redis Cache Configuration (Optional - Falls back cleanly if absent)
# Option A: Full Connection URI (e.g., Redis Cloud, Upstash, Render Redis)
# REDIS_URL=redis://default:password@host:port
# Option B: Docker Compose Local Redis
# REDIS_URL=redis://redis:6379

# Google Gemini AI (Optional - Enables AI Resume & Skill Match Analysis)
GEMINI_API_KEY=your_gemini_api_key_here
